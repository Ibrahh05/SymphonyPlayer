<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/vav_graph"
    app:startDestination="@id/logginFragment">

    <fragment
        android:id="@+id/logginFragment"
        android:name="com.example.loggin.fragments.LogginFragment"
        android:label="Iniciar Sesión"
        tools:layout="@layout/loggin_fragment">
        <action
            android:id="@+id/action_logginFragment_to_registroFragment"
            app:destination="@id/registroFragment" />
        <action
            android:id="@+id/action_logginFragment_to_recuperarContrasenaFragment"
            app:destination="@id/recuperarContrasenaFragment" />
    </fragment>

    <fragment
        android:id="@+id/registroFragment"
        android:name="com.example.loggin.fragments.Registro"
        android:label="Registro"
        tools:layout="@layout/fragment_registro" />

    <fragment
        android:id="@+id/recuperarContrasenaFragment"
        android:name="com.example.loggin.fragments.RecuperarContrasenaFragment"
        android:label="Recuperar Contraseña"
        tools:layout="@layout/fragment_recuperar_contrasena" />

</navigation>