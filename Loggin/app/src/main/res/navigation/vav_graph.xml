<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/vav_graph.xml">
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/FragmentUno">


    <activity
        android:id="@+id/mainActivity"
        android:name="com.example.fragmentsdinamicos.MainActivity"
        android:label="activity_main"
        tools:layout="@layout/activity_main" />
        app:startDestunation="FragmentoUno"


    <fragment
        android:id="@+id/FragmentUno"
        android:name="com.example.fragmentsdinamicos.fragments.FragmentUno"
        android:label="First Fragment"
        tools:layout="@layout/fragment_uno" >


        <action

            android:id="@+id/action_firstFragment_to_secondFragment"
            app:destination="@id/FragmentDos" />


    </fragment>


    <fragment
        android:id="@+id/FragmentDos"
        android:name="com.example.fragmentsdinamicos.fragments.FragmentDos"
        android:label="Second Fragment"
        tools:layout="@layout/fragment_dos">
        <action

            android:id="@+id/action_firstFragment_to_secondFragment"
            app:destination="@id/FragmentDos" />


    </fragment>

</navigation>